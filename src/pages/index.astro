---
import Layout from '../layouts/Layout.astro';
import GameCard from '../components/GameCard.astro';
import PageHero from '../components/PageHero.astro';
import EmptyState from '../components/EmptyState.astro';
import { getDatabase } from '../lib/db';
import { getAllGames } from '../lib/games';

export const prerender = true;

const games = await getAllGames(getDatabase());
---

<Layout title="Tailspin Toys - Crowdfunding your new favorite game!">
  <div class="py-8">
    <PageHero
      title="Welcome to Tailspin Toys"
      subtitle="Find your next game! And maybe even back one! Explore our collection!"
    />

    <div>
      <h2 class="text-2xl font-medium mb-6 text-slate-100">Featured Games</h2>

      {games.length === 0 ? (
        <EmptyState text="No games available at the moment." />
      ) : (
        <>
          <div id="game-search" class="mb-6" role="search" aria-label="Game catalog" hidden>
            <label for="game-title-search" class="block mb-2 font-medium text-slate-100">
              Search game titles
            </label>
            <input
              type="search"
              id="game-title-search"
              data-testid="game-title-search"
              class="w-full sm:max-w-md rounded-lg border border-slate-500 bg-slate-800 px-3 py-2 text-slate-100 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-blue-400"
            />
            <p id="game-search-status" class="mt-3 text-sm text-slate-300" role="status" aria-atomic="true"></p>
          </div>
          <div id="games-grid" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6" data-testid="games-grid">
            {games.map((game) => <GameCard game={game} />)}
          </div>
        </>
      )}
    </div>
  </div>
</Layout>

<script>
  import { matchesGameTitle } from '../lib/game-search';

  const search = document.querySelector<HTMLElement>('#game-search');
  const input = document.querySelector<HTMLInputElement>('#game-title-search');
  const status = document.getElementById('game-search-status');
  const cards = document.querySelectorAll<HTMLElement>('#games-grid [data-game-title]');

  if (search && input && status) {
    const filterGames = (): void => {
      let matches = 0;
      for (const card of cards) {
        const isMatch = matchesGameTitle(card.dataset.gameTitle ?? '', input.value);
        card.classList.toggle('hidden!', !isMatch);
        if (isMatch) matches++;
      }

      const message = matches === 0
        ? 'No games match your search.'
        : matches === 1
          ? '1 game found.'
          : matches === cards.length
            ? `Showing all ${matches} games.`
            : `${matches} games found.`;
      if (status.textContent !== message) status.textContent = message;
    };

    input.addEventListener('input', filterGames);
    filterGames();
    search.hidden = false;
  }
</script>
