---
import Layout from '../layouts/Layout.astro';
import GameCard from '../components/GameCard.astro';
import PageHero from '../components/PageHero.astro';
import EmptyState from '../components/EmptyState.astro';
import { getDatabase } from '../lib/db';
import { getAllGames, getCatalogSummary } from '../lib/games';

export const prerender = true;

const games = await getAllGames(getDatabase());
const catalogSummary = await getCatalogSummary(getDatabase());
const totalGamesLabel = `${catalogSummary.totalGames} game${catalogSummary.totalGames === 1 ? '' : 's'}`;
const averageRatingLabel =
  catalogSummary.averageStarRating === null
    ? 'No ratings yet'
    : `${catalogSummary.averageStarRating.toFixed(1)} / 5`;
---

<Layout title="Tailspin Toys - Crowdfunding your new favorite game!">
  <div class="py-8">
    <PageHero
      title="Welcome to Tailspin Toys"
      subtitle="Find your next game! And maybe even back one! Explore our collection!"
    />

    <section
      aria-label="Catalog summary"
      class="mb-8 grid grid-cols-1 sm:grid-cols-2 gap-4"
      data-testid="catalog-summary"
    >
      <article class="rounded-xl border border-slate-700 bg-slate-800/60 p-4" data-testid="catalog-summary-total">
        <p class="text-sm text-slate-300">Total games</p>
        <p class="text-2xl font-semibold text-slate-100" data-testid="catalog-total-games">{totalGamesLabel}</p>
      </article>
      <article class="rounded-xl border border-slate-700 bg-slate-800/60 p-4" data-testid="catalog-summary-average">
        <p class="text-sm text-slate-300">Average star rating</p>
        <p class="text-2xl font-semibold text-slate-100" data-testid="catalog-average-rating">{averageRatingLabel}</p>
      </article>
    </section>

    <div>
      <h2 class="text-2xl font-medium mb-6 text-slate-100">Featured Games</h2>

      {games.length === 0 ? (
        <EmptyState text="No games available at the moment." />
      ) : (
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6" data-testid="games-grid">
          {games.map((game) => <GameCard game={game} />)}
        </div>
      )}
    </div>
  </div>
</Layout>
